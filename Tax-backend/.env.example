PORT=4000
NODE_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=taxation_system
ALLOW_DB_AUTOMIGRATION=true
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
# Sandbox by default. Use https://checkout.payway.com.kh for live PayWay credentials.
ABA_PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# Must be publicly reachable over HTTPS and configured/whitelisted with ABA.
ABA_PAYWAY_CALLBACK_URL=https://your-domain.example/api/khqr/payway/callback
CORS_ORIGIN=http://localhost:5173
ADMIN_EMAIL=your-recovery-address@gmail.com
ADMIN_PASSWORD=change-this-strong-admin-password
# Use either the generic SMTP settings below or the Gmail settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GMAIL_USER=your-account@gmail.com
# Gmail sender account. Use a Google App Password, not its normal password.
# Spaces in the 16-character App Password are accepted and removed.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
